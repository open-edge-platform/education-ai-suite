# Copy to .env and adjust as needed:  cp .env.example .env

VA_DLSTREAMER_IMAGE=intel/dlstreamer:2026.2.0-ubuntu24

# Render group GID for /dev/dri + NPU/GPU passthrough:
#   RENDER_GID=$(getent group render | cut -d: -f3)
RENDER_GID=

# MediaMTX: RTSP server VA pipelines push video into via rtspclientsink.
# Default config works as-is (anonymous publish/read on any path) -- no custom
# Dockerfile/mediamtx.yml needed.
VA_MEDIAMTX_IMAGE=bluenviron/mediamtx:1.20.0
VA_MEDIAMTX_RTSP_PORT=8554

# Tag for the locally-built va-pipeline image (docker-compose.yml).
VA_TAG=latest

# Corporate proxy (intel/dlstreamer bakes these in; needed here too so
# docker-compose build/pull can reach the internet). Leave blank off-network.
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
NO_PROXY=
no_proxy=

