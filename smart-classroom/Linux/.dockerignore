# Keep the Docker build context small and reproducible.
# Include application source, but never bake runtime search data into the image.

# VCS / editor
.git/
.gitignore
**/.DS_Store

# Python caches / envs
**/__pycache__/
**/*.py[cod]
.venv/
venv/
.pytest_cache/
tests/

# UI build artifacts (rebuilt inside the image)
ui/node_modules/
ui/dist/
ui/.vite/

# Runtime / generated data
models/
storage/
monitoring/logs/
monitoring/executionlogs/
content_search/data/
content_search/logs/
content_search/tests/
*.log

# metrics-collector builds from this directly (context: performance-tools);
# the app image never needs it.
performance-tools/

# Compose / env files
docker-compose*.yml
.env
.env.*
!.env.example
