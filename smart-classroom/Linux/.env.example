COMPOSE_PROFILES=

# Pin the compose project name so named volumes (model-cache, storage, etc.)
# stay stable across runs regardless of the cwd `docker compose` is invoked
# from (otherwise Compose derives it from the directory containing the
# compose file / --project-directory, which can silently switch volumes).
COMPOSE_PROJECT_NAME=smart-classroom

# Optional UI build override. Leave blank to auto-target the current host on :8000.
VITE_API_BASE_URL=


# setup.sh fills this in from the host's render group; required for GPU access.
RENDER_GID=

# --- metrics-collector sidecar (live Resource Utilization dashboard) --------
# Built locally from the vendored performance-tools/ submodule (live-metrics
# isn't in any published intel/retail-benchmark tag yet - see
# docker/docker-compose.yml). Run `git submodule update --init` first.
# URL the app backend polls for /metrics and /platform-info (see
# monitoring/monitor.py). Default matches the docker-compose service name.
METRICS_COLLECTOR_URL=http://metrics-collector:9000

SERVING_BASE_URL=http://ovms:9000

HF_TOKEN=
ENABLED_PLUGINS=huggingface,openvino
OVMS_RELEASE_TAG=v2026.4.1

# --- audio-analyzer ASR microservice ----------------------------------------
# Only used by the optional manual local-build Compose override.
# Includes FunASR and ModelScope dependencies; does not affect the pulled image.
INSTALL_CJK=true
