COMPOSE_PROFILES=

COMPOSE_PROJECT_NAME=smart-classroom

# Optional UI build override. Leave blank to auto-target the current host on :8000.
VITE_API_BASE_URL=

# setup.sh fills this in from the host's render group; required for GPU access.
RENDER_GID=

# On a TLS-inspecting corporate proxy, `app.Dockerfile`'s GPU-runtime
# download step and `video-analytics/docker/Dockerfile.va-provision` can fail
# with "SSL: CERTIFICATE_VERIFY_FAILED" because the proxy re-signs some
# outbound HTTPS hosts with an internal CA the build image doesn't trust.
# Point this at a PEM file with that CA (often already trusted system-wide
# under /etc/ssl/certs on a corporate-managed host) to fix it; leave blank
# everywhere else — both Dockerfiles' `--secret id=corporate_ca` step is a
# verified no-op without it.
CORPORATE_CA_FILE=

INTEL_IMAGE_TAG=latest    #Docker Hub image tag (shared) 

# --- metrics-collector sidecar (live Resource Utilization dashboard) --------
# URL the app backend polls for /metrics and /platform-info (see
# monitoring/monitor.py). Default matches the docker-compose service name.
METRICS_COLLECTOR_URL=http://metrics-collector:9000

SERVING_BASE_URL=http://ovms:9000

# --- model-downloader service -----------------------------------------------
# Shared by text-gen (OVMS exports) and asr (audio-analyzer snapshots).
# `modelscope` is required for the FunASR/Paraformer ASR models.
HF_TOKEN=
ENABLED_PLUGINS=huggingface,openvino,modelscope
OVMS_RELEASE_TAG=v2026.4.1
# Managed by `python -m utils.compose_profiles --write-env` (setup.sh runs it):
# present only while the text-gen profile is active, removed otherwise so an
# ASR-only stack does not export the VLM/embedding/reranker models.
STARTUP_MODELS_CONFIG=/opt/startup-models.yaml

# --- audio-analyzer ASR microservice ----------------------------------------
# Includes FunASR and ModelScope dependencies; does not affect the pulled image.
INSTALL_CJK=true
# ASR/diarization snapshots are requested from the shared model-downloader at
# startup (AUDIO_ANALYZER_MODEL_DOWNLOAD_URL is fixed in docker-compose.yml).
# Raise this if large first-run downloads exceed 30 minutes on your network.
AUDIO_ANALYZER_MODEL_DOWNLOAD_TIMEOUT_SEC=1800
