COMPOSE_PROFILES=

# Optional UI build override. Leave blank to auto-target the current host on :8000.
VITE_API_BASE_URL=


RENDER_GID=

# --- metrics-collector sidecar (live Resource Utilization dashboard) --------
# Built locally from the vendored performance-tools/ submodule (live-metrics
# isn't in any published intel/retail-benchmark tag yet - see
# docker/docker-compose.yml). Run `git submodule update --init` first.
# URL the app backend polls for /metrics and /platform-info (see
# monitoring/monitor.py). Default matches the docker-compose service name.
METRICS_COLLECTOR_URL=http://metrics-collector:9000

SERVING_BASE_URL=http://ovms:9000

HF_TOKEN=
ENABLED_PLUGINS=huggingface,openvino
OVMS_RELEASE_TAG=v2026.3

# --- audio-analyzer ASR microservice ----------------------------------------
# Bundles the FunASR Paraformer (Chinese/English) ASR provider into the
# audio-analyzer image. Must stay true because the committed service config
INSTALL_CJK=true
